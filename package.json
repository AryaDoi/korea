{
  "name": "warung-rmb",
  "version": "1.0.0",
  "description": "Warung RMB - Korean Items Reseller Platform",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc",
    "preview": "wrangler deploy --compatibility-flags nodejs_compat",
    "format": "prettier --write '**/*.{ts,js,json,md}'",
    "lint": "eslint src/",
    "pages:dev": "wrangler pages dev ./public",
    "pages:deploy": "wrangler pages deploy ./public"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "itty-router": "^4.0.0",
    "jose": "^5.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^3.114.17"
  }
}
